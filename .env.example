# Neon integration provides this value in Vercel.
DATABASE_URL=

# Admin identity label. Access also requires the separately created password.
ADMIN_EMAILS=you@example.com
ADMIN_SESSION_SECRET=
# Set two DIFFERENT random secrets (32-256 characters). Never commit them.
# ADMIN_SETUP_KEY is only required when creating the first password.
ADMIN_SETUP_KEY=

# Optional: can also be configured from the admin panel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Blob provides BLOB_STORE_ID + VERCEL_OIDC_TOKEN on Vercel.
# For local development you can use BLOB_READ_WRITE_TOKEN instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
