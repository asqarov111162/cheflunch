# Neon integration provides this value in Vercel.
DATABASE_URL=

# The first configured email can open /admin after entering the admin password.
ADMIN_EMAILS=you@example.com
ADMIN_SESSION_SECRET=replace-with-a-long-random-secret

# Optional: can also be configured from the admin panel.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Vercel Blob provides BLOB_STORE_ID + VERCEL_OIDC_TOKEN on Vercel.
# For local development you can use BLOB_READ_WRITE_TOKEN instead.
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=
